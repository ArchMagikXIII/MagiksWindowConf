{
  "$schema": "https://raw.githubusercontent.com/glzr-io/zebar/main/resources/zpack-schema.json",
  "name": "Magik Bar",
  "version": "1.0.0",
  "description": "A waybar-style status bar matching the OdysseyWM theme.",
  "tags": ["bar", "waybar", "minimal"],
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./index.html",
      "zOrder": "bottom_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["*.html", "*.css"],
      "privileges": {
        "shellCommands": [
          { "program": "taskmgr.exe", "argsRegex": ".*" },
          { "program": "ms-settings:.*", "argsRegex": ".*" },
          { "program": "powershell.exe", "argsRegex": ".*get-wallpaper-colors\\.ps1.*" }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0",
          "offsetY": "0",
          "width": "100%",
          "height": "28px",
          "monitorSelection": { "type": "primary" },
          "dockToEdge": { "enabled": true, "edge": "top", "windowMargin": "0px" }
        }
      ]
    }
  ]
}
